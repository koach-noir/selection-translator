{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/tauri_conf_schema.json",
  "productName": "Selection Translator",
  "version": "0.1.0",
  "identifier": "dev.noirk.selection-translator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Settings",
        "url": "/settings/index.html",
        "width": 480,
        "height": 600,
        "resizable": false,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
